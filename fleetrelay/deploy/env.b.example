# Computer-B — kopiraj u deploy/.env.b
# Lokalni razvoj: KAFKA_BROKERS=127.0.0.1:9092
# Dva računara: KAFKA_BROKERS=<IPv4 Computer-A>:9092

COMPOSE_PROJECT_NAME=fleetrelay-b

POSTGRES_PORT=5432
POSTGRES_DB=fleetrelay
POSTGRES_USER=fleetrelay
POSTGRES_PASSWORD=fleetrelay

REDIS_PORT=6379

# go-consumer + cmd/api (host procesi)
FLEETRELAY_POSTGRES_DSN=postgres://fleetrelay:fleetrelay@127.0.0.1:5432/fleetrelay?sslmode=disable
FLEETRELAY_REDIS_ADDR=127.0.0.1:6379
FLEETRELAY_KAFKA_BROKERS=127.0.0.1:9092
FLEETRELAY_KAFKA_GROUP_PRESENCE=fleetrelay-presence
FLEETRELAY_KAFKA_GROUP_INGEST=fleetrelay-ingest
FLEETRELAY_KAFKA_GROUP_SAGA=fleetrelay-saga
FLEETRELAY_WORKER_CONCURRENCY=8
FLEETRELAY_WORKER_QUEUE=256
FLEETRELAY_HEARTBEAT_FLUSH_MAX=1000
FLEETRELAY_HEARTBEAT_FLUSH_EVERY=100ms
FLEETRELAY_DEDUP_TTL=24h
FLEETRELAY_PRESENCE_STALE=30s
FLEETRELAY_API_HTTP_ADDR=:8080
FLEETRELAY_API_GRPC_ADDR=:9090
FLEETRELAY_CONSUMER_METRICS_ADDR=:9092
FLEETRELAY_API_METRICS_ADDR=:9093
FLEETRELAY_CATALOG_PARTNERS=200
FLEETRELAY_CATALOG_DRIVERS=5000
FLEETRELAY_CATALOG_VEHICLES=5000
