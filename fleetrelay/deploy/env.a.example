# Computer-A — kopiraj u deploy/.env.a
# Lokalni razvoj (sve na jednoj mašini): ostavi localhost.
# Dva računara: KAFKA_EXTERNAL_HOST = IPv4 Computer-A na WiFi-ju (ipconfig).

COMPOSE_PROJECT_NAME=fleetrelay-a

KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9092

MONGO_PORT=27017
MONGO_DB=fleetrelay
MONGO_USER=fleetrelay
MONGO_PASSWORD=fleetrelay

# go-producer (host proces, ne kontejner)
FLEETRELAY_MONGO_URI=mongodb://fleetrelay:fleetrelay@127.0.0.1:27017/fleetrelay?authSource=admin
FLEETRELAY_KAFKA_BROKERS=127.0.0.1:9092
FLEETRELAY_KAFKA_PRODUCER_ACKS=heartbeat:1,verification:all
FLEETRELAY_BURST_RATE=20000
FLEETRELAY_BURST_DURATION=7m
FLEETRELAY_IDLE_BETWEEN_BURSTS=26m30s
FLEETRELAY_BURSTS_PER_CYCLE=3
FLEETRELAY_CYCLE_PAUSE=1h
FLEETRELAY_CATALOG_PARTNERS=200
FLEETRELAY_CATALOG_DRIVERS=5000
FLEETRELAY_CATALOG_VEHICLES=5000
FLEETRELAY_MIX_HEARTBEAT=0.98
FLEETRELAY_MIX_VERIFICATION=0.015
FLEETRELAY_MIX_CLASSIFY=0.005
FLEETRELAY_GENERATOR_WORKERS=8
FLEETRELAY_OUTBOX_FLUSH_MAX=500
FLEETRELAY_OUTBOX_FLUSH_EVERY=50ms
FLEETRELAY_PUBLISHER_BATCH=2000
FLEETRELAY_PUBLISHER_EVERY=50ms
FLEETRELAY_PRODUCER_METRICS_ADDR=:9091
